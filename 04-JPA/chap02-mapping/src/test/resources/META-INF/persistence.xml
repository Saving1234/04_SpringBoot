<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

<!--    엔티티 매니저 팩토리를 식별하기 위한 이름 설정. 주석은 ctrl + /-->

    <persistence-unit name="jpatest">
<!--        엔티티 클래스를 정의.-->
        <class>com.bear.section01.entity.Member</class>
        <class>com.bear.section02.enumType.Member</class>
        <class>com.bear.section03.field.Member</class>
        <class>com.bear.practice.ColumnMember</class>
        <class>com.bear.practice.EntityNameMember</class>
        <class>com.bear.practice.EnumMember</class>
        <class>com.bear.practice.IdentityMember</class>
        <class>com.bear.practice.PropertyAccessMember</class>


        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="1234"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/menudb"/>
<!--  hipernate 설정. jpa에 의해 실행되는 SQL 구문을 콘솔에 보여준다.         -->
            <property name="hibernate.show_sql" value="true"/>
<!--      SQL 구문을 개행처리해서 보기 좋게 출력.              -->
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.highlight_sql" value="true"/>
            <property name="hibernate.hbm2ddl.auto" value="create"/>

<!--    entity 변경할 시, 팀원들과 꼭 상의.
        그래서 yaml 파일 잘 관리할 것.
       none          :아무것도 하지 않음. default.  운영할 때도 가능
운영중에는 안하고 개발할 때만 사용. 기존 데이터가 날라가기 때문에 조심해서 사용
      create        : 실행할 때마다 기존 drop, 새로 생성
      create-drop   : create와 같지만 어플리케이션 종료할 때 drop
      update        :  기존 테이블을 유지하나 채 변경된 부분(컬럼추가)만 반영(삭제 or 타입 변경은 반영안됨.)
      validate      : ;ddl 실행을 하지 않고 구조가 맞는지 검증만 진행. 이것도 검증이니 운영할 때도 가능.
          .-->

<!--   엔티티 클래스 기준으로 hibernate가 ddl(테이블 생성/삭제)을 자동으로 수행하는 설정 d  -->
        </properties>

    </persistence-unit>

</persistence>